const word ALLOC_STATE_SIZE = (word) 24;
const word ALLOC_HEAP_OFF = (word)0;
const word ALLOC_SIZE_OFF = (word)8;
const word ALLOC_HEAD_OFF = (word)16;
const word HEADER_SIZE = (word)24;
const word SIZE_OFF = (word)0;
const word FREE_OFF = (word)8;
const word NEXT_OFF = (word)16;

fn exit(err_code: int): void {	
	syscall(0x3c, err_code);
}

fn open(file_name: word, flags: int, mode: word): int{
	return (int)syscall(0x02, file_name, flags, mode);
}

fn close(file_descriptor: int): void{
	syscall(0x03, file_descriptor);
}

fn write(fd: int, buf: word, count: int): void {
	syscall(1, fd, buf, count);	
}

fn byte_out(out: char): void {
	write(1, &out, 1);
}

fn byte_in(): char{
	char in = (char)0;
	if(read(0, &in, 1) != 0) {
		return in;
	}
	return 0;
}

fn print(num: int): void{
	char[256] buf;
	print_string(integer_to_ascii(num, &buf, 10));
	byte_out('\n');
}

fn read(fd: int, buf: word, count: int): word {
	return syscall(0, fd, buf, count);	
}

fn read_line(fd: int, buffer: word, max_len: int) :int {
	if ((buffer == 0) || (max_len < 1)) {
		return -1;
	}
    char ch = (char)0;
    for (int i = 0; i < (max_len - 1); i = i + 1;) {
        if (read(fd, &ch, 1) != 1) {
            break; 
        }
        byte_out(ch);
        if (ch == '\n') {
            break;
        }
        *(char)(buffer + i) = ch;
    }
    *(char)(buffer + i) = (char)0;
    return i;
}


fn mmap(addr: word, length: word, prot: int, flags: int, fd: int, offset: word): word {
	return syscall(9, addr, length, prot, flags, fd, offset);
}

fn munmap(addr: word, length: word): word{
	return syscall(11, addr, length);
}

fn memcpy(dest: word, src: word, n:int): void {
	for (int i = 0; i < n; i = i + 1;) {
		*(char)(dest + i) = *(char)(src + i);
	}
}

fn memset(dest: word, value: char, n: int): void {
	for (int i = 0; i < n; i = i + 1;) {
		*(char)(dest + i) = value;
	}
}

fn memeql(a:word, b:word, n: int): bool {
	for (int i = 0; i < n; i = i + 1;) {
		if ( (int)*(char)(a) != (int)*(char)(b)) {
			byte_out(*(char)a);
			byte_out(10);
			byte_out(*(char)b);
			return (bool)0;
		}
		a = a + 1;
		b = b + 1;
	}
	return (bool)1;
} 

fn strlen(s: word): int {
	int i = 0;
	while(*(char)s != 0) {
		i = i + 1;
		s = s + 1;
	}
	return i;
}

fn strcmp(sa: word, sb: word): int {
	int ret = 0;
	while( (*(char)sa != 0) && (*(char)sa != 0)) {
		if (ret != 0) {
			return ret;
		}
		ret = (int)(*(char)sa - *(char)sb);
		sa = sa + 1;
		sb = sb + 1;
	}
	return ret;
}
fn strcpy(dest: word, src: word): void {
	int len = strlen(src);
	memcpy(dest, src, len);
}

fn print_string(str: word): void {
	write(1, str, strlen(str));
}
fn print_int(n: int): void {
	char[256] buf;
	print_string(integer_to_ascii(n, &buf, 10));
}
fn print_hex(n:int ): void {
	char[256] buf;
	print_string(integer_to_ascii(n, &buf, 16));
}

fn is_digit(c:char): bool{
	return (48 <= c) && (c <= 57);
}

fn exp(base: int, power: int): int {
    int val = 1;
    for(int p = power; p != 0; p = p-1;) {
        val = val * base;
    }
    return val;}

fn ascii_to_integer(str: word): int {
    word str_ptr = str;
    int val = 0;
    int len = strlen(str);
    bool is_negative = (bool)0;
    if (*(char)(str_ptr) == '-') {
        is_negative = (bool)1;
        str_ptr = str_ptr + 1;
        len = len - 1;  
    } else if (*(char)(str_ptr) == '+') {
        str_ptr = str_ptr + 1;
        len = len - 1;
    }
    for (int index = 0; index < len; index = index + 1; ) {
        char current_char = *(char)(str_ptr + index);
        if (is_digit(current_char)) {
            val = val * 10 + (current_char - 48);
        } else {
            break;
        }
    }
    
    if (is_negative) {
        val = -val;
    }
    
    return val;
}

fn integer_to_ascii(n: int, buffer: word, base: int): word {
	int i = 0;
	bool is_negative = (bool)0;
	if (n == 0) {
		*(char)buffer = '0';
		*(char)(buffer + 1) = (char)0;
		return buffer;
	}
	if ((n < 0) && (base == 10)){
		is_negative = (bool)1;
		n = -n;
	}
	while (n > 0) {
		int digit = n % base;
		if (digit < 10) {
			*(char)(buffer+i) = '0' + (char)digit;
		} else {
			*(char)(buffer+i) = 'a' + (char)(digit-10);
		}
		i = i + 1;
		n = n / base;
	}
	if (is_negative) {
		*(char)(buffer+i) = '-';
		i = i + 1;
	}
	*(char)(buffer+i) = (char)0;
	reverse(buffer, i);
	return buffer;
}

fn reverse(buff: word, count: int): void{
	int start = 0;
	int end = count - 1;
	while(start < end) {
		char tempa = *(char)(buff + start);
		char tempb = *(char)(buff + end);
		*(char)(buff + start) = tempb;
		*(char)(buff + end) = tempa;
		start = start + 1;
		end = end - 1;
	}
}

fn alloc_create(heap_size: word): word {
	word state = mmap(
		0,
		ALLOC_STATE_SIZE,
		3, 
		0x22,
		-1,
		0
	);
	if (state == 0) {
		return 0;
	}
	word heap = mmap(
		0,
		heap_size,
		3, 
		0x22,
		-1,
		0
	);

	if (heap == 0) {
		munmap(state, ALLOC_STATE_SIZE);
		return 0;
	}
	
	*(word)(state + ALLOC_HEAP_OFF) = heap;
	*(word)(state + ALLOC_SIZE_OFF) = heap_size;
	*(word)(state + ALLOC_HEAD_OFF) = heap;

	*(word)(heap + SIZE_OFF) = heap_size - HEADER_SIZE;
	*(char)(heap + FREE_OFF) = (char)1;
	*(word)(heap + NEXT_OFF) = (word)0;
}

fn align(n: int, a: int): int {
	return (n + a -1 ) & ~(a - 1);
}

fn alloc(state: word, size: int): word {
	if ((state == 0) || (state <= 0)) {
		return 0;
	}
	size = align(size, 8);
	word curr = *(word)(state + ALLOC_HEAP_OFF);
	while(curr != 0){
		bool free = (bool)*(char)(curr+FREE_OFF);
		word curr_size = *(word)(curr + SIZE_OFF);
		if (free && (curr_size >= size)) {
			word remaining = curr_size - size;
			if (remaining >=  HEADER_SIZE + 8) {
				word new_block  = curr + HEADER_SIZE + size;
				*(word)(new_block+SIZE_OFF) = remaining - HEADER_SIZE;
				*(char)(new_block+FREE_OFF) = (char)1;
				*(word)(new_block+NEXT_OFF) = *(word)(curr + NEXT_OFF);
				*(word)(curr + NEXT_OFF) = new_block;
                *(word)(curr + SIZE_OFF) = size;
			}
			*(char)(curr + FREE_OFF) = (char)0;
            return curr + HEADER_SIZE;
		}
		curr = *(word)(curr + NEXT_OFF);
	}
	return 0;
}
fn free(state: word, ptr: word): void {
    if ((state == 0) || (ptr == 0)) {
        return;
    }

    word block = ptr - HEADER_SIZE;
    *(char)(block + FREE_OFF) = (char)1;

    word next = *(word)(block + NEXT_OFF);
    if ((next != 0) && (*(bool)(next + FREE_OFF))) {
        *(word)(block + SIZE_OFF) =
            *(word)(block + SIZE_OFF)
            + HEADER_SIZE
            + *(word)(next + SIZE_OFF);

        *(word)(block + NEXT_OFF) =
            *(word)(next + NEXT_OFF);
    }
}

fn allocator_destroy(state: word): void {
    if (state == 0) {
        return;
    }
    word heap = *(word)(state + ALLOC_HEAP_OFF);
    word size = *(word)(state + ALLOC_SIZE_OFF);
    if ((heap != 0) && (size > 0)) {
        munmap(heap, size);
    }
    munmap(state, ALLOC_STATE_SIZE);
}

